{
  "name": "vinext",
  "version": "0.1.0",
  "description": "Next.js-compatible framework built on Vite",
  "type": "module",
  "bin": {
    "vinext": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./unified-request-context": "./dist/unified-request-context.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "@vitejs/plugin-react": "6.0.1",
    "@vitejs/plugin-rsc": "0.5.19",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vite": "8.0.2"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-react": { "optional": true },
    "@vitejs/plugin-rsc": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "vite": { "optional": true }
  },
  "engines": {
    "node": ">=20"
  }
}
